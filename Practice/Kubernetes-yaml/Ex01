
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-app
  namespace: prod

spec:
  replicas: 3

  selector:
    matchLabels:
      app: web-app

  template:
    metadata:
      labels:
        app: web-app

    spec:
      containers:
        - name: web-app
          image: python:3.12
          ports:
            - containerPort: 8080

          resources:
            requests:
              cpu: "1000m"
              memory: "5Gi"
            limits:
              cpu: "2000m"
              memory: "10Gi"

          startupProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 5
            failureThreshold: 5

          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 5

          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 5

---
apiVersion: v1
kind: Service
metadata:
  name: web-app
  namespace: prod

spec:
  type: ClusterIP

  selector:
    app: web-app

  ports:
    - port: 80
      targetPort: 8080
